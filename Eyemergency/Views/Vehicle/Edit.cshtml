@model Eyemergency.Models.Vehicle

@{
    ViewBag.Title = "Edit Vehicle";
}
<div class="container p-4">
<h2>Edit Vehicle</h2>

<form asp-action="Edit" asp-controller="Vehicle" method="post" class="form">
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.UserId)
    <div class="mb-3">
        @Html.LabelFor(m => m.TagId, htmlAttributes: new { @class = "form-label" })
        @Html.TextBoxFor(m => m.TagId, new { @class = "form-control", @readonly = "readonly" }) 
        @Html.ValidationMessageFor(m => m.TagId, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.VehicleName, htmlAttributes: new { @class = "form-label" })
        @Html.TextBoxFor(m => m.VehicleName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.VehicleName, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.VehicleType, htmlAttributes: new { @class = "form-label" })
        @Html.TextBoxFor(m => m.VehicleType, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.VehicleType, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a href="@Url.Action("Index", "Vehicle")" class="btn btn-secondary">Cancel</a>
</form>
</div>