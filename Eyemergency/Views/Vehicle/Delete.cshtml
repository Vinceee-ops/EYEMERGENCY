@model Eyemergency.Models.Vehicle

@{
    ViewBag.Title = "Delete Vehicle";
}
<partial name="Header" />
<partial name="SideNav" />
<div class="container p-4">
<h2>Delete Vehicle</h2>

<div class="alert alert-warning">
    <p>Are you sure you want to delete this vehicle?</p>
</div>

<table class="table table-bordered">
    <tr>
        <th>Tag ID</th>
        <td>@Model.TagId</td>
    </tr>
    <tr>
        <th>Vehicle Name</th>
        <td>@Model.VehicleName</td>
    </tr>
    <tr>
        <th>Vehicle Type</th>
        <td>@Model.VehicleType</td>
    </tr>
    <tr>
        <th>Registered At</th>
        <td>@Model.RegisteredAt</td>
    </tr>
</table>

<form asp-action="Delete" asp-controller="Vehicle" method="post">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("Index", "Vehicle")" class="btn btn-secondary">Cancel</a>
</form>
</div>