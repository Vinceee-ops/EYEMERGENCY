@model IEnumerable<Eyemergency.Models.Vehicle>

@{
    ViewBag.Title = "Registered Vehicles";
}
<partial name="Header" />
<partial name="SideNav" />
    <div class="container p-4">
<a href="@Url.Action("Create", "Vehicle")" class="btn btn-primary mb-3">Register New Vehicle</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tag ID</th>
            <th>Vehicle Name</th>
            <th>Vehicle Type</th>
            <th>Registered At</th>
                <th>Actions</th>
        </tr>
    </thead>
    <tbody>
                @foreach (var vehicle in Model)
                {
                <tr>
                    <td>@vehicle.Id</td>
                    <td>@vehicle.TagId</td>
                    <td>@vehicle.VehicleName</td>
                    <td>@vehicle.VehicleType</td>
                    <td>@vehicle.RegisteredAt</td>
                    <td>
                        <a href="@Url.Action("Edit", "Vehicle", new { id = vehicle.Id })" class="btn btn-sm btn-warning">Edit</a>
                        <a href="@Url.Action("Delete", "Vehicle", new { id = vehicle.Id })" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
                }
    </tbody>
</table>
    </div>

