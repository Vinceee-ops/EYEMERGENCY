@model Eyemergency.Models.Vehicle

@{
    ViewBag.Title = "Register New Vehicle";
}
<div class="container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Register New Vehicle</h2>
        <a href="@Url.Action("Index", "Vehicle")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Vehicles
        </a>
    </div>

    <form asp-action="Create" asp-controller="Vehicle" method="post" class="form">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    @Html.LabelFor(m => m.TagId, htmlAttributes: new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.TagId, new { @class = "form-control", id = "tagIdField" })
                    @Html.ValidationMessageFor(m => m.TagId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.VehicleName, htmlAttributes: new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.VehicleName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.VehicleName, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.VehicleType, htmlAttributes: new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.VehicleType, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.VehicleType, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Index", "Vehicle")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Register Vehicle
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tagIdField = document.getElementById('tagIdField');

            // Function to fetch the latest tag ID from the server
            function fetchTagId() {
                fetch('/api/rfid')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.tagId) {
                            tagIdField.value = data.tagId;
                            // Optional: Show success feedback
                            console.log('RFID tag updated:', data.tagId);
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching tag ID:', error);
                        // Optional: Show error to user
                    });
            }

            // Poll the server for new tag IDs every 2 seconds
            const pollInterval = setInterval(fetchTagId, 2000);

            // Clean up interval when leaving the page
            window.addEventListener('beforeunload', function() {
                clearInterval(pollInterval);
            });
        });
    </script>
}