@using Microsoft.AspNetCore.Identity
@using Eyemergency.Areas.Identity.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


<div class="sidebar">
    <div class="profile d-flex flex-column justify-content-center align-items-center mb-5">
        <div class="mx-2">
            <img src="~/assets/logo.png" style="height:120px;width:120px" />
        </div>
        <div class="d-flex flex-column justify-content-center align-items-center">
            <div class="user">
                @UserManager.GetUserAsync(User).Result.StationName
            </div>
            <div class="user">
                @UserManager.GetUserAsync(User).Result.Email
            </div>
        </div>
    </div>
    <nav class="nav flex-column">
        <a class="nav-link" asp-area="" asp-action="Index" asp-controller="Home">
            <span class="icon">
                <i class="fa-solid fa-house"></i>
            </span>
            <span class="title">Home</span>
        </a>
        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Dashboard">
            <span class="icon">
                <i class="fa-solid fa-gauge"></i>
            </span>
            <span class="title">Dashboard</span>
        </a>
        @if (User.IsInRole("Local"))
        {
            <a class="nav-link" asp-area="" asp-controller="Vehicle" asp-action="Index">
                <span class="icon">
                    <i class="fa-solid fa-car"></i>
                </span>
                <span class="title">Vehicles</span>
            </a>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmergencyTickets" asp-action="StationTickets">
                    <i class="fas fa-tasks"></i> My Tickets
                </a>
            </li>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Regional"))
        {
            <a class="nav-link" href="#" data-bs-toggle="collapse" data-bs-target="#submenu" aria-expanded="false" aria-controls="submenu">
                <span class="icon">
                    <i class="fa-solid fa-user-tie"></i>
                </span>
                <span class="title">Administration<i class="fa-solid fa-caret-down mx-4"></i></span>
            </a>
            <div class="submenu collapse" id="submenu">
                <a class="nav-link" asp-area="" asp-controller="Administration" asp-action="Users">
                    <span class="icon">
                        <i class="fa-solid fa-users"></i>
                    </span>
                    <span class="title">Users</span>
                </a>
            </div>
            <a class="nav-link" asp-area="" asp-controller="EmergencyTickets" asp-action="Index">
                <span class="icon">
                    <i class="fa-solid fa-ticket"></i>
                </span>
                <span class="title">Ticket</span>
            </a>
        }
        <a class="nav-link" id="register" asp-area="Identity" asp-page="/Account/Manage/Index">
            <span class="icon">
                <i class="fa-solid fa-gear"></i>
            </span>
            <span class="title">User Settings</span>
        </a>
    </nav>
</div>
