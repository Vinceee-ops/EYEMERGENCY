@model Eyemergency.Models.EmergencyTicket
@using Eyemergency.Areas.Identity.Data
@using Eyemergency.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject EyemergencyDbContext _context

@{
    ViewData["Title"] = "Assign Ticket";

    // Get all user IDs in "Local" role first
    var localUsers = await UserManager.GetUsersInRoleAsync("Local");
    var localUserIds = localUsers.Select(u => u.Id).ToList();

    // Query users with emergency vehicles
    var stationUsersWithEmergencyVehicles = await _context.Users
        .Where(u => localUserIds.Contains(u.Id))
        .Where(u => _context.Vehicle.Any(v => v.UserId == u.Id && v.IsEmergencyVehicle == false))
        .OrderBy(u => u.StationName)
        .ToListAsync();
}

<div class="container p-4">

<h2>Assign Ticket #@Model.TicketId</h2>
<h4>@Model.EmergencyType Emergency at @Model.Location</h4>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Assign">
            <input type="hidden" asp-for="TicketId" />

            <div class="form-group">
                <!-- Updated field for assigning to station user -->
                <div class="mb-3">
                        <select asp-for="AssignedToUserId" class="form-control">
                            <option value="">-- Select Station --</option>
                            @foreach (var user in stationUsersWithEmergencyVehicles)
                            {
                                var vehicleCount = await _context.Vehicle
                                .CountAsync(v => v.UserId == user.Id && v.IsEmergencyVehicle == false);

                                <option value="@user.Id">
                                    @user.StationName (@vehicleCount emergency vehicles)
                                </option>
                            }
                        </select>
                    <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-group mt-5">
                <input type="submit" value="Assign" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-default">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>